DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

POSTGRES_DB=monecole
POSTGRES_USER=monecole
POSTGRES_PASSWORD=monecole
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Devise et localisation par défaut des nouveaux établissements
DEFAULT_CURRENCY=XOF
DEFAULT_COUNTRY=SN

# LaFricaMobile (LAMPUSH) — SMS. Vide = mode simulation, aucun envoi réel.
LAM_ACCESS_KEY=
LAM_ACCESS_PASSWORD=
LAM_SENDER_ID=MonEcole

# Wave Business API. Vide = mode simulation.
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:5173

# --- Messagerie (réinitialisation de mot de passe) ---------------------------
# Sans EMAIL_HOST, Django écrit les courriers sur la console : commode en
# développement, inopérant en production. Voir docs/messagerie.md.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MonEcole <ne-pas-repondre@monecole.sn>
