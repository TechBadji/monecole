# MonÉcole — variables de production.
#
# À copier en `.env` sur le serveur, jamais dans git : ce dépôt est public.
#   cp .env.prod.example .env && nano .env
#
# Voir docs/deploiement.md.

# --- Django -------------------------------------------------------------
# Obligatoire. L'application refuse de démarrer sans elle : sa valeur de repli
# est publiée dans ce dépôt et signe les jetons d'authentification.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=ecole.exemple.sn,www.ecole.exemple.sn

# --- Base de données ----------------------------------------------------
POSTGRES_DB=monecole
POSTGRES_USER=monecole
POSTGRES_PASSWORD=

# --- Adresse publique ---------------------------------------------------
# Compose les liens de réinitialisation de mot de passe et les retours de
# paiement Wave. Laissée vide, les liens envoyés pointent vers localhost.
PUBLIC_BASE_URL=https://ecole.exemple.sn
CORS_ALLOWED_ORIGINS=https://ecole.exemple.sn

# --- Messagerie ---------------------------------------------------------
# Sans identifiants, Django écrit les courriers dans les journaux : le circuit
# paraît fonctionner et personne ne reçoit rien. Voir docs/messagerie.md.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- SMS (LAfricaMobile) ------------------------------------------------
# Absents, les envois passent en simulation : ils sont consignés, pas expédiés.
LAM_ACCESS_KEY=
LAM_ACCESS_PASSWORD=
LAM_SENDER=MONECOLE

# --- Paiement Wave ------------------------------------------------------
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
